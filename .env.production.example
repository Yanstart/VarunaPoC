# ==============================================================================
# VarunaPoC - Production Environment Configuration
# ==============================================================================
# Copy this file:  cp .env.production.example .env.production
# Then fill in all [REQUIRED] fields before deploying.
# ==============================================================================

# ==============================================================================
# DOCKER IMAGES (GHCR)
# ==============================================================================
BACKEND_IMAGE=ghcr.io/yanstart/varunapoc/backend
BACKEND_IMAGE_TAG=main
FRONTEND_IMAGE=ghcr.io/yanstart/varunapoc/frontend
FRONTEND_IMAGE_TAG=main
BACKEND_REPLICAS=2

# ==============================================================================
# POSTGRESQL / POSTGIS [REQUIRED]
# ==============================================================================
POSTGRES_DB=varuna
POSTGRES_USER=varuna
POSTGRES_PASSWORD=            # [REQUIRED] - Set a strong password

# ==============================================================================
# REDIS [REQUIRED]
# ==============================================================================
REDIS_PASSWORD=               # [REQUIRED] - Set a strong password
REDIS_MAX_MEMORY=4gb

# ==============================================================================
# SLIDE STORAGE
# ==============================================================================
# Path on the host where WSI slide files are mounted (NAS/SAN)
SLIDES_HOST_PATH=/mnt/chu-slides

# ==============================================================================
# APPLICATION
# ==============================================================================
LOG_LEVEL=info
# Number of uvicorn worker processes. Default: 1.
# Recommended for production: (2 * CPU_count) + 1
# Example: 4-core host -> 9 workers
UVICORN_WORKERS=1
CORS_ORIGINS=https://varuna.chu-ucl.be
AUTH_ENABLED=false

# ==============================================================================
# NGINX / TLS
# ==============================================================================
NGINX_SERVER_NAME=varuna.your-hospital.be    # [REQUIRED] Domain name for TLS certificate
NGINX_SSL_CERT=/etc/nginx/ssl/varuna.crt     # Path inside container
NGINX_SSL_KEY=/etc/nginx/ssl/varuna.key      # Path inside container
HTTP_PORT=80
HTTPS_PORT=443

# ==============================================================================
# AUTHENTICATION (--profile auth)
# ==============================================================================
# Only required when running with: --profile auth
KEYCLOAK_ADMIN_PASSWORD=      # [REQUIRED with --profile auth]
KEYCLOAK_DB_PASSWORD=         # [REQUIRED with --profile auth]
KEYCLOAK_HOSTNAME=auth.your-hospital.be   # External hostname for Keycloak (behind nginx)
OIDC_ISSUER_URL=https://auth.your-hospital.be/realms/varuna  # Must match KEYCLOAK_HOSTNAME, use HTTPS

# ==============================================================================
# MACHINE LEARNING
# ==============================================================================
ML_ENABLED=true
ML_PROVIDER=slideflow

# ==============================================================================
# MONITORING (--profile monitoring)
# ==============================================================================
# Only required when running with: --profile monitoring
GRAFANA_ADMIN_PASSWORD=       # [REQUIRED with --profile monitoring]
GRAFANA_ROOT_URL=             # Grafana public URL (used for links in alerts/emails)
