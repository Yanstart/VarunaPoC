# Default: auto-detect text files and normalize to LF in repo, native on checkout
* text=auto eol=lf

# Explicit text files (always LF, prevents CRLF surprises on Windows)
*.sh    text eol=lf
*.py    text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# Windows-only files keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary files (never normalized)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.dump  binary
*.dcm   binary
*.mrxs  binary
*.bif   binary
*.tif   binary
*.tiff  binary
*.svs   binary
*.czi   binary
