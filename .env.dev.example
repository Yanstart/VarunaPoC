# =============================================================================
# VarunaPoC — Development environment template
# =============================================================================
# Copy this file to `.env` and adjust if needed. Defaults are tuned for a
# developer workstation: weak passwords, all ports exposed on localhost,
# auth disabled by default in the backend.
#
# Bring up the dev stack:
#     cp .env.dev.example .env
#     docker compose --profile dev up -d
#
# This launches: db + redis + keycloak (+ keycloak-db) + orthanc + hapi-fhir
# Backend and frontend you run locally with `uvicorn` and `npm run dev`.
# =============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL (profile: core | dev | prod)
# ----------------------------------------------------------------------------
POSTGRES_DB=varuna
POSTGRES_USER=varuna
POSTGRES_PASSWORD=varuna_dev
POSTGRES_HOST_PORT=5433

# ----------------------------------------------------------------------------
# Redis (profile: cache | dev | prod)
# Leave REDIS_PASSWORD empty for unauthenticated dev mode.
# ----------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_HOST_PORT=6380
REDIS_MAX_MEMORY=2gb

# ----------------------------------------------------------------------------
# Keycloak (profile: auth | dev | prod)
# `start-dev` mode is fine for development; switch to `start --optimized`
# in production via .env.prod.
# ----------------------------------------------------------------------------
KEYCLOAK_COMMAND=start-dev --import-realm
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak_dev
KEYCLOAK_HOST_PORT=8180
KC_HOSTNAME=localhost
KC_HOSTNAME_STRICT_HTTPS=false
KC_PROXY=edge

# ----------------------------------------------------------------------------
# Orthanc PACS sandbox (profile: pacs | dev)
# ----------------------------------------------------------------------------
ORTHANC_DICOM_HOST_PORT=4242
ORTHANC_HTTP_HOST_PORT=8042
ORTHANC_USER=varuna
ORTHANC_PASSWORD=varuna_dev
PACS_AET_LOCAL=VARUNA_SCU
PACS_AET_REMOTE=ORTHANC

# ----------------------------------------------------------------------------
# HAPI FHIR sandbox (profile: fhir | dev)
# ----------------------------------------------------------------------------
FHIR_HOST_PORT=8090

# ----------------------------------------------------------------------------
# Monitoring (profile: monitoring | prod) — usually OFF in dev
# Uncomment if you want to test alerts locally.
# ----------------------------------------------------------------------------
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# ALERTMANAGER_HOST_PORT=9093
# PROMETHEUS_RETENTION=7d

# ----------------------------------------------------------------------------
# MLOps (profile: mlops) — OFF by default in dev
# ----------------------------------------------------------------------------
# MLFLOW_HOST_PORT=5000
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# MINIO_ROOT_USER=varuna-admin
# MINIO_ROOT_PASSWORD=varuna_dev
# MLOPS_DB_PASSWORD=mlops_dev

# ----------------------------------------------------------------------------
# App services (profile: prod) — OFF in dev (you run uvicorn/npm locally)
# Only needed if you want to test the production app images locally.
# ----------------------------------------------------------------------------
# BACKEND_IMAGE=ghcr.io/yanstart/varunapoc/backend
# BACKEND_IMAGE_TAG=main
# BACKEND_REPLICAS=1
# FRONTEND_IMAGE=ghcr.io/yanstart/varunapoc/frontend
# FRONTEND_IMAGE_TAG=main
# UVICORN_WORKERS=1
# LOG_LEVEL=debug
# CORS_ORIGINS=http://localhost,http://localhost:5173
# AUTH_ENABLED=false
# OIDC_ISSUER_URL=http://keycloak:8080/realms/varuna
# ML_ENABLED=true
# ML_PROVIDER=slideflow
# ML_WORKER_BACKEND=subprocess
# TILE_CACHE_L2_ENABLED=true
# FHIR_ENABLED=false
# FHIR_BASE_URL=http://hapi-fhir:8080/fhir
# PACS_ENABLED=false
# PACS_HOST=orthanc
# WORKFLOW_WS_BROADCAST_ENABLED=true
# SLIDES_HOST_PATH=./Slides
# NGINX_SERVER_NAME=localhost
# HTTP_PORT=80
# HTTPS_PORT=443
