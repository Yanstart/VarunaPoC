# VarunaPoC Backend Configuration - Phase 2.2 (Network Access, CHU Infrastructure Slides)
# =============================================================================
# Phase 2.2: Frontend accessible from PC clients via network (http://varun-p-01)
# Slides: CHU network share (\\imgsv-01-p\anapath_storage_nimble)

# Application Environment
ENVIRONMENT=phase2.2-network-chu-infrastructure
LOG_LEVEL=INFO

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# API URLs
API_BASE_URL=http://varun-p-01:8000
FRONTEND_URL=http://varun-p-01

# CORS Configuration (allow network access)
CORS_ORIGINS=http://varun-p-01,http://localhost,http://localhost:5173

# Slides Repository
SLIDES_REPOSITORY_PATH=/slides
# Note: /slides in container maps to /mnt/chu-slides on host
# Host mount: \\imgsv-01-p\anapath_storage_nimble → /mnt/chu-slides

# CHU Infrastructure Configuration
NETWORK_SHARE_PATH=\\\\imgsv-01-p\\anapath_storage_nimble
NETWORK_SHARE_MOUNT_POINT=/mnt/chu-slides
# Credentials managed externally (Windows credential manager or fstab)

# Performance Configuration (adjusted for network latency)
MAX_TILE_CACHE_SIZE=200
TILE_SIZE=256
MAX_SLIDE_CACHE_SIZE=20
NETWORK_TIMEOUT=60

# OpenSlide Configuration
OPENSLIDE_TIMEOUT=60

# Logging
LOG_FILE_PATH=/app/logs/varuna-backend-phase2.2.log
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_DAYS=30

# Security (basic for Phase 2.2)
ALLOWED_HOSTS=varun-p-01,localhost
TRUSTED_PROXIES=

# Monitoring
HEALTH_CHECK_ENDPOINT=/api/v1/health

# Phase 2.2 Specific Notes:
# - Server exposed on 0.0.0.0:8000 (accessible from network)
# - CORS allows http://varun-p-01 (PC clients)
# - Slides from CHU network share: \\imgsv-01-p\anapath_storage_nimble
# - Network share must be mounted at /mnt/chu-slides BEFORE starting containers
# - DNS: varun-p-01 and imgsv-01-p must resolve
# - Firewall: Ports 80, 8000, and SMB (445) must be open
# - Network latency: Increased timeouts and cache sizes
# - SMB version: 3.0 or higher recommended
#
# Mounting Network Share (Windows Server):
# net use Z: \\imgsv-01-p\anapath_storage_nimble /user:DOMAIN\USERNAME PASSWORD /persistent:yes
# mklink /D C:\mnt\chu-slides Z:\
#
# Mounting Network Share (Linux):
# sudo mkdir -p /mnt/chu-slides
# sudo mount -t cifs -o username=USER,password=PASS,vers=3.0,uid=1000,gid=1000 \
#   //imgsv-01-p/anapath_storage_nimble /mnt/chu-slides
#
# Add to /etc/fstab for persistent mount:
# //imgsv-01-p/anapath_storage_nimble /mnt/chu-slides cifs credentials=/root/.smbcredentials,vers=3.0,uid=1000,gid=1000 0 0
