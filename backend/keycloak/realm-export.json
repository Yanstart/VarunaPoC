  "clients": [
    {
      "id": "varuna-viewer-client-id",
      "clientId": "varuna-viewer",
      "name": "VarunaPoC Viewer Client",
      "description": "Frontend client for VarunaPoC medical imaging viewer",
      "rootUrl": "http://localhost:5173",
      "adminUrl": "",
      "baseUrl": "http://localhost:5173",
      "surrogateAuthRequired": false,
      "enabled": true,
      "alwaysDisplayInConsole": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:8080/*"
