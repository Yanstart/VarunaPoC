# VarunaPoC Backend Environment Configuration (Phase 1 - Local Validation)
# This file is used for Docker deployment testing on localhost

# ============================================
# Slides Repository Configuration
# ============================================
# Path to slides directory inside Docker container
# Docker volume mounts /local/slides -> /slides
SLIDES_REPOSITORY_PATH=/slides

# ============================================
# API Configuration
# ============================================
# Base URL for this backend API
API_BASE_URL=http://localhost:8000

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost

# ============================================
# Environment and Logging
# ============================================
# Environment identifier
ENVIRONMENT=phase1-local

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# ============================================
# CORS Configuration
# ============================================
# Allowed origins for CORS (comma-separated)
# Phase 1: Allow localhost on both port 80 and default
CORS_ORIGINS=http://localhost,http://localhost:80

# ============================================
# Performance Tuning (Future)
# ============================================
# Maximum number of slides to keep in cache (not implemented yet)
# MAX_SLIDE_CACHE_SIZE=10

# Tile cache directory (not implemented yet)
# TILE_CACHE_DIR=/var/cache/varuna/tiles
