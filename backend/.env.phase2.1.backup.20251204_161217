# VarunaPoC Backend Configuration - Phase 2.1 (Network Access, Local Slides)
# =============================================================================
# Phase 2.1: Frontend accessible from PC clients via network (http://varun-p-01)
# Slides: Local mount (/local/slides)

# Application Environment
ENVIRONMENT=phase2.1-network-local-slides
LOG_LEVEL=INFO

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# API URLs
API_BASE_URL=http://varun-p-01:8000
FRONTEND_URL=http://varun-p-01

# CORS Configuration (allow network access)
CORS_ORIGINS=http://varun-p-01,http://localhost,http://localhost:5173

# Slides Repository
SLIDES_REPOSITORY_PATH=/slides
# Note: /slides in container maps to /local/slides on host

# Performance Configuration
MAX_TILE_CACHE_SIZE=100
TILE_SIZE=256
MAX_SLIDE_CACHE_SIZE=10

# OpenSlide Configuration
OPENSLIDE_TIMEOUT=30

# Logging
LOG_FILE_PATH=/app/logs/varuna-backend-phase2.1.log
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_DAYS=30

# Security (basic for Phase 2.1)
ALLOWED_HOSTS=varun-p-01,localhost
TRUSTED_PROXIES=

# Monitoring
HEALTH_CHECK_ENDPOINT=/api/health

# Phase 2.1 Specific Notes:
# - Server exposed on 0.0.0.0:8000 (accessible from network)
# - CORS allows http://varun-p-01 (PC clients)
# - Slides from local mount (not network share yet)
# - DNS: varun-p-01 must resolve to server IP
# - Firewall: Ports 80 and 8000 must be open
