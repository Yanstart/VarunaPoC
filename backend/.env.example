SLIDES_DIR=../Slides

# ============================================
# Database Configuration (Phase 2)
# ============================================
DATABASE_URL=postgresql+asyncpg://varuna:varuna_dev@localhost:5433/varuna  # pragma: allowlist secret

# ============================================
# ML Configuration
# ============================================
# Provider: "slideflow" (production), "openslide" (heuristic), "mock" (tests)
ML_PROVIDER=slideflow
ML_ENABLED=true

# Mode: "extractor" (Phase 1-2) or "classifier" (Phase 3)
ML_MODE=extractor

# Feature extractor name (Phase 1-2)
# Available: resnet50_imagenet, virchow, ctranspath, retccl, uni, phikon, gigapath, plip
# Core (Apache-2.0): resnet50_imagenet, virchow
# GPL (pip install slideflow-gpl): ctranspath, retccl
# Non-commercial (pip install slideflow-noncommercial): uni, phikon, gigapath, plip
ML_EXTRACTOR=resnet50_imagenet

# Classification model path (Phase 3 - leave empty for extractor mode)
# ML_MODEL_PATH=models/gleason_v1.pt
# ML_MODEL_ID=gleason_grading_v1

# Classification classes
ML_CLASSES=tissue,background

# Advanced
# ML_TILE_SIZE=224
# ML_MC_SAMPLES=10

# ============================================
# Auth Configuration (Phase 3)
# ============================================
# Set to true to require OIDC authentication (default: false = anonymous mode)
AUTH_ENABLED=false

# OIDC Provider (Keycloak dev, Azure AD prod, Imprivata)
OIDC_ISSUER_URL=http://localhost:8180/realms/varuna
OIDC_CLIENT_ID=varuna-viewer
OIDC_AUDIENCE=varuna-viewer
# Role claim path: Keycloak=realm_access.roles, Azure AD=roles
OIDC_ROLE_CLAIM=realm_access.roles
# JWKS cache TTL in seconds
OIDC_JWKS_CACHE_TTL=3600

# ============================================
# FHIR Configuration (Phase 3)
# ============================================
FHIR_ENABLED=false
