SLIDES_DIR=../Slides

# ============================================
# Database Configuration (Phase 2)
# ============================================
DATABASE_URL=postgresql+asyncpg://varuna:varuna_dev@localhost:5433/varuna  # pragma: allowlist secret

# ============================================
# ML Configuration
# ============================================
# Provider: "slideflow" (production), "openslide" (heuristic), "mock" (tests)
ML_PROVIDER=slideflow
ML_ENABLED=true

# Mode: "extractor" (Phase 1-2) or "classifier" (Phase 3)
ML_MODE=extractor

# Feature extractor name (Phase 1-2)
# Available: resnet50_imagenet, virchow, ctranspath, retccl, uni, phikon, gigapath, plip
# Core (Apache-2.0): resnet50_imagenet, virchow
# GPL (pip install slideflow-gpl): ctranspath, retccl
# Non-commercial (pip install slideflow-noncommercial): uni, phikon, gigapath, plip
ML_EXTRACTOR=resnet50_imagenet

# Classification model path (Phase 3 - leave empty for extractor mode)
# ML_MODEL_PATH=models/gleason_v1.pt
# ML_MODEL_ID=gleason_grading_v1

# Classification classes
ML_CLASSES=tissue,background

# Advanced
# ML_TILE_SIZE=224
# ML_MC_SAMPLES=10

# ML Worker backend (Sprint 11 — MLWorkerProvider Protocol)
# - subprocess (default): MLWorkerProxy. Forks a Slideflow worker process,
#   ~5GB resident, isolated from FastAPI. Required for Slideflow because
#   of its GIL-blocking loops.
# - inprocess: InProcessMLWorker. Runs ML in the FastAPI event loop via the
#   configured ML_PROVIDER. Suitable for ONNX Runtime / OpenVINO that release
#   the GIL during native ops. Cheap; avoid with Slideflow.
# - triton: TritonClientMLWorker (stub today). Will talk HTTP/gRPC to a
#   remote Triton Inference Server. Configure TRITON_URL + TRITON_MODEL_NAME.
ML_WORKER_BACKEND=subprocess

# Triton client (only used when ML_WORKER_BACKEND=triton)
# TRITON_URL=http://triton.internal:8000
# TRITON_PROTOCOL=http
# TRITON_MODEL_NAME=varuna_pathology
# TRITON_MODEL_VERSION=
# TRITON_TIMEOUT_SECONDS=60

# ============================================
# Auth Configuration (Phase 3)
# ============================================
# OIDC authentication is enabled by default. Set to false for dev/testing only.
AUTH_ENABLED=true

# OIDC Provider (Keycloak dev, Azure AD prod, Imprivata)
OIDC_ISSUER_URL=http://localhost:8180/realms/varuna
OIDC_CLIENT_ID=varuna-viewer
OIDC_AUDIENCE=varuna-viewer
# Role claim path: Keycloak=realm_access.roles, Azure AD=roles
OIDC_ROLE_CLAIM=realm_access.roles
# JWKS cache TTL in seconds
OIDC_JWKS_CACHE_TTL=3600

# ============================================
# Tile Cache Configuration (Phase 5)
# ============================================
# L2 (Redis) caching for tile bytes. Falls back to L1 (in-process memory)
# only if disabled or Redis unreachable.
TILE_CACHE_L2_ENABLED=true
TILE_CACHE_L2_TTL_SECONDS=3600

# Redis backend for TileCache L2 + future distributed coordination.
# Dev: launch via `docker compose -f docker-compose.dev.yml up -d redis`.
# Host port 6380 in dev (avoids conflict with a possible local Redis on 6379);
# production uses 6379 — see docker-compose.production.yml.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CONNECT_TIMEOUT=2.0

# ============================================
# FHIR Configuration (Phase 3 — DPI integration via FHIRWorkflowHook)
# ============================================
# Active the FHIR workflow hook. When false, NoOpWorkflowHook is used
# (events are logged but no DiagnosticReport is sent to the DPI).
FHIR_ENABLED=false

# FHIR R4 endpoint. Dev: HAPI FHIR container in docker-compose.dev.yml on
# host port 8090. Production: point at the hospital's real FHIR server.
FHIR_BASE_URL=http://localhost:8090/fhir

# Optional bearer token for protected FHIR servers.
FHIR_AUTH_TOKEN=

# Per-request timeout in seconds.
FHIR_TIMEOUT_SECONDS=10

# Retry policy for transient 5xx / network failures (exponential backoff).
FHIR_RETRY_MAX_ATTEMPTS=3
FHIR_RETRY_BACKOFF_SECONDS=2

# ============================================
# PACS Configuration (Tier 4 — DICOM via PACSWorkflowHook)
# ============================================
# Activate the DICOM workflow hook. When false, only the FHIR hook (or
# NoOp) runs. When both PACS and FHIR are enabled, events fan out to
# both via CompositeWorkflowHook.
PACS_ENABLED=false

# DICOM endpoint of the remote PACS server. Dev: Orthanc container in
# docker-compose.dev.yml on host port 4242. Production: hospital PACS.
PACS_HOST=localhost
PACS_DICOM_PORT=4242

# Orthanc HTTP REST endpoint, used for update_worklist (no native DIMSE-C
# equivalent). Dev: 8042. Production: vendor-specific (may be unset for
# non-Orthanc PACS — update_worklist will then raise NotImplementedError).
PACS_HTTP_URL=http://localhost:8042

# AE Titles. PACS_AET_LOCAL is VarunaPoC as the SCU; PACS_AET_REMOTE is
# the SCP on the PACS. Both are configurable to match the PACS vendor's
# allow-list. No defaults baked into source — set them before running.
PACS_AET_LOCAL=
PACS_AET_REMOTE=

# Optional HTTP basic-auth credentials for the Orthanc REST endpoint
# (default Orthanc dev container: varuna / varuna_dev).
PACS_HTTP_USER=
PACS_HTTP_PASSWORD=

# Per-association DICOM timeout (seconds) and retry policy for transient
# network / negotiation failures (exponential backoff).
PACS_TIMEOUT_SECONDS=30
PACS_RETRY_MAX_ATTEMPTS=2
PACS_RETRY_BACKOFF_SECONDS=2
