# VarunaPoC Frontend Configuration - Phase 2.2 (Network Access, CHU Infrastructure)
# =============================================================================
# Phase 2.2: Frontend accessible from PC clients via network (http://varun-p-01)
# Slides from CHU infrastructure

# API Configuration
VITE_API_URL=http://varun-p-01:8000

# Environment
VITE_ENVIRONMENT=phase2.2-network-chu

# Application Title
VITE_APP_TITLE=VarunaPoC - WSI Viewer (Phase 2.2 - CHU Infrastructure)

# Feature Flags
VITE_ENABLE_DEBUG=false
VITE_ENABLE_ANALYTICS=false

# OpenSeadragon Configuration
VITE_OSD_TILE_SIZE=256
VITE_OSD_PREFETCH_LEVEL=2
# Increased prefetch for network latency compensation

# Phase 2.2 Specific Notes:
# - API accessible at http://varun-p-01:8000
# - Frontend served from http://varun-p-01 (port 80)
# - DNS: varun-p-01 must resolve to server IP
# - Network access required from PC clients
# - Slides from CHU network share (backend handles)
