# VarunaPoC Frontend Environment Configuration (Phase 1 - Local Validation)
# This file is used for Docker deployment testing on localhost

# ============================================
# Backend API Configuration
# ============================================
# URL to backend API (must be accessible from browser)
# Phase 1: Backend runs on localhost:8000
VITE_API_URL=http://localhost:8000

# ============================================
# Environment Identifier
# ============================================
# Environment name for logging/debugging
VITE_ENVIRONMENT=phase1-local

# ============================================
# Feature Flags (Future)
# ============================================
# Enable/disable features for testing
# VITE_ENABLE_ANNOTATIONS=false
# VITE_ENABLE_MEASUREMENTS=false
# VITE_DEBUG_MODE=true
