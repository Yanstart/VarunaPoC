# =============================================================================
# VarunaPoC — Production environment template
# =============================================================================
# Copy this file to `.env` on the production host and replace EVERY default
# password before starting any service. Then:
#
#     docker compose --profile prod --profile monitoring up -d
#
# This launches the full app stack (backend + frontend + nginx) plus the
# core/cache/auth services and the monitoring stack. Add --profile mlops
# if you also run the training pipeline on this host. Add --profile pacs
# or --profile fhir ONLY for sandbox installations; in real hospital
# deployments you point FHIR_BASE_URL / PACS_HOST at the hospital servers
# instead of running the sandbox containers.
#
# SECURITY CHECKLIST — do not deploy until each of these is true:
#  [ ] Every PASSWORD/SECRET below is replaced with a strong value
#  [ ] CORS_ORIGINS lists ONLY trusted domains
#  [ ] NGINX_SSL_CERT / NGINX_SSL_KEY point at real certificates
#  [ ] BACKEND_IMAGE_TAG / FRONTEND_IMAGE_TAG are pinned to a release tag
#  [ ] Off-host backups configured for varuna-db-data + varuna-prometheus-data
# =============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_DB=varuna
POSTGRES_USER=varuna
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_HOST_PORT=5432

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_HOST_PORT=6379
REDIS_MAX_MEMORY=4gb

# ----------------------------------------------------------------------------
# Keycloak
# ----------------------------------------------------------------------------
KEYCLOAK_COMMAND=start --optimized --import-realm
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_keycloak_admin
KEYCLOAK_DB_PASSWORD=CHANGE_ME_strong_keycloak_db
KEYCLOAK_HOST_PORT=8180
KC_HOSTNAME=auth.example.org
KC_HOSTNAME_STRICT_HTTPS=true
KC_PROXY=edge

# ----------------------------------------------------------------------------
# App images (replace with your registry / pinned tag)
# ----------------------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/yanstart/varunapoc/backend
BACKEND_IMAGE_TAG=v0.1.0
BACKEND_REPLICAS=2
FRONTEND_IMAGE=ghcr.io/yanstart/varunapoc/frontend
FRONTEND_IMAGE_TAG=v0.1.0

# ----------------------------------------------------------------------------
# Backend runtime
# ----------------------------------------------------------------------------
UVICORN_WORKERS=2
LOG_LEVEL=info
CORS_ORIGINS=https://varuna.hospital.example
AUTH_ENABLED=true
OIDC_ISSUER_URL=https://auth.example.org/realms/varuna
ML_ENABLED=true
ML_PROVIDER=slideflow
ML_WORKER_BACKEND=subprocess
TILE_CACHE_L2_ENABLED=true
FHIR_ENABLED=true
FHIR_BASE_URL=https://fhir.hospital.example/fhir
PACS_ENABLED=true
PACS_HOST=pacs.hospital.example
WORKFLOW_WS_BROADCAST_ENABLED=true
SLIDES_HOST_PATH=/mnt/chu-slides

# ----------------------------------------------------------------------------
# Nginx
# ----------------------------------------------------------------------------
NGINX_SERVER_NAME=varuna.hospital.example
NGINX_SSL_CERT=/etc/nginx/ssl/varuna.crt
NGINX_SSL_KEY=/etc/nginx/ssl/varuna.key
HTTP_PORT=80
HTTPS_PORT=443

# ----------------------------------------------------------------------------
# Monitoring
# ----------------------------------------------------------------------------
PROMETHEUS_HOST_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana
GRAFANA_ROOT_URL=https://grafana.hospital.example
ALERTMANAGER_HOST_PORT=9093

# ----------------------------------------------------------------------------
# MLOps (only if --profile mlops is active)
# ----------------------------------------------------------------------------
MLFLOW_HOST_PORT=5000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=varuna-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio
MLOPS_DB_PASSWORD=CHANGE_ME_strong_mlops_db
